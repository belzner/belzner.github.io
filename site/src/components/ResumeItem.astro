---
const { place, location, site, roles = [] } = Astro.props;
---

<div class="work-item">
    <h3 class="place">{place} - <span class="location">{location}</span> - <a href={site} target="_blank">Website</a></h3>
    <ul class="roles">{roles.map(role => (
        <li><strong>{role.title}</strong>, {role.dates}</li>
    ))}</ul>
    <div>
        <slot name="description" />
    </div>
</div>

<style>
.work-item {
    margin-top: 1rem;
}

.place {
    margin: 0;
}

.location {
    font-style: italic;
    font-weight: 400;
}

.roles {
    list-style: none;
    padding-left: 0;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.875rem;
}
</style>
