---
import Layout from '../layouts/Layout.astro';
import Hello from '../components/Hello.astro';
import Section from '../components/Section.astro';
import ResumeItem from '../components/ResumeItem.astro';

// TODO descriptions, skills
---

<Layout>
	<Hello />
	<Section title="Work Experience" side="left">
        <ResumeItem
            place="Lithic (fka Privacy.com)"
            location="New York, NY"
            site="https://lithic.com"
            roles={[
                { title: 'Staff Software Engineer, Privacy.com', dates: 'Jan 2024-Present' },
                { title: 'Senior Software Engineer, Privacy.com', dates: 'Mar 2022-Jan 2024' },
                { title: 'Engineering Lead, Product Engineering', dates: 'Apr 2020-Mar 2022' },
                { title: 'Software Engineer', dates: 'Nov 2018-Apr 2020' },
            ]}
        />
        <ResumeItem
            place="Skillshare"
            location="New York, NY"
            site="https://skillshare.com"
            roles={[
                { title: 'Software Engineer, Tech Lead', dates: 'Oct 2017-Nov 2018' },
                { title: 'Associate Software Engineer', dates: 'Jul 2016-Oct 2017' },
            ]}
        />
        <ResumeItem
            place="Luminoso"
            location="Cambridge, MA"
            site="https://luminoso.com"
            roles={[
                { title: 'Frontend Development Intern', dates: 'Summer 2015' },
            ]}
        />
        <ResumeItem
            place="Tumblr"
            location="New York, NY"
            site="https://tumblr.com"
            roles={[
                { title: 'Product Engineering Intern', dates: 'Summer 2014' },
            ]}
        />
	</Section>
	<Section title="Education" side="right">
        <ResumeItem
            place="Massachusetts Institute of Technology"
            location="Cambridge, MA"
            site="https://mit.edu"
            roles={[
                { title: 'Bachelor of Science in Computer Science and Engineering', dates: '2012-2016' },
            ]}
        />
	</Section>
</Layout>
