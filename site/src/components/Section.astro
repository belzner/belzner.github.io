---
const { title, side } = Astro.props;

const boxShadowSize = '0.5rem';
---

<section class:list={['section', side, { 'has-title': !!title }]}>
    {title ? 
        <div class="title-wrapper"><h2 class="title">{title}</h2></div>
        : ''}
    <div class="inner-section">
        <div class="text-section">
            <slot />
        </div>
    </div>
</section>

<style lang="scss" define:vars={{ boxShadowSize }}>
.section {
    position: relative;
    background-color: #f49cdaff;
    border: 2px solid #000000;
    box-shadow: -0.2rem var(--boxShadowSize);
    max-width: 800px;
    width: 80%;
    margin: 2rem;
}

.inner-section {
    background-color: #ffffff;
    border: 2px solid #000000;
    margin: 2rem;
    padding: 2rem;
}

.has-title {
    margin-top: 4rem;
    padding-top: 2.5rem;
}

.title {
    position: absolute;
    background-color: #ffffff;
    border: 2px solid #000000;
    box-shadow: -0.2rem var(--boxShadowSize);
    margin: 0;
    padding: 0.5rem;
    top: -3rem;
    font-size: 3.5rem;
	font-family: "Fugaz One", Arial, Helvetica, sans-serif;
}

.left {
    transform: perspective(4rem) rotateY(1deg);
    box-shadow: calc(-1 * var(--boxShadowSize)) var(--boxShadowSize);

    .title {
        box-shadow: calc(-1 * var(--boxShadowSize)) var(--boxShadowSize);
        left: 1.5rem;
    }

    .inner-section {
        padding-inline: 1rem;
    }

    .text-section {
        transform: perspective(4rem) rotateY(-1deg);
        margin-left: 0;
        margin-right: 5rem;
    }
}

.right {
    transform: perspective(4rem) rotateY(-1deg);
    box-shadow: var(--boxShadowSize) var(--boxShadowSize);

    .title {
        box-shadow: var(--boxShadowSize) var(--boxShadowSize);
        right: 1.5rem;
    }

    .inner-section {
        padding-inline: 1rem;
    }

    .text-section {
        transform: perspective(4rem) rotateY(1deg);
        margin-left: 5rem;
        margin-right: 0;
    }
}

@media screen and (max-width: 680px) {
    .section:not(.has-title) {
        margin: 1rem;
        width: 90%;
    }

    .title {
        font-size: 2.5rem;
    }

    .has-title {
        padding-top: 1.5rem;
    }

    .inner-section {
        margin: 1.5rem;
    }

    .left {
        .text-section {
            margin-right: 1rem;
        }
    }

    .right {
        .text-section {
            margin-left: 1rem;
        }
    }
}

@media screen and (max-width: 480px) {
    .title {
        font-size: 2rem;
    }

    .has-title {
        padding-top: 1rem;
    }

    .inner-section {
        padding: 1rem;
    }
}
</style>
