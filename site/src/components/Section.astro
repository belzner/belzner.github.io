---
const { title, side } = Astro.props;

const boxShadowSize = '0.5rem';
---

<section class:list={['section', side]}>
    <div class="title-wrapper"><h2 class="title">{title}</h2></div>
    <div class="inner-section">
        <div class="text-section">
            <slot />
        </div>
    </div>
</section>

<style lang="scss" define:vars={{ boxShadowSize }}>
.section {
    position: relative;
    background-color: #f49cdaff;
    border: 2px solid #000000;
    max-width: 800px;
    width: 80%;
    margin: 4rem 2rem 2rem;
}

.left {
    transform: perspective(4rem) rotateY(1deg);
    box-shadow: calc(-1 * var(--boxShadowSize)) var(--boxShadowSize);

    .title {
        box-shadow: calc(-1 * var(--boxShadowSize)) var(--boxShadowSize);
        left: 1.5rem;
    }

    .text-section {
        transform: perspective(4rem) rotateY(-1deg);
        margin-left: 0;
        margin-right: 5rem;
    }
}

.right {
    transform: perspective(4rem) rotateY(-1deg);
    box-shadow: var(--boxShadowSize) var(--boxShadowSize);

    .title {
        box-shadow: var(--boxShadowSize) var(--boxShadowSize);
        right: 1.5rem;
    }

    .text-section {
        transform: perspective(4rem) rotateY(1deg);
        margin-left: 5rem;
        margin-right: 0;
    }
}

.inner-section {
    background-color: #ffffff;
    border: 2px solid #000000;
    margin: 2rem;
    padding: 2.5rem 1rem 2rem;
}

.title {
    position: absolute;
    background-color: #ffffff;
    border: 2px solid #000000;
    margin: 0;
    padding: 0.5rem;
    top: -3rem;
    font-size: 3.5rem;
	font-family: "Fugaz One", Arial, Helvetica, sans-serif;
}
</style>
